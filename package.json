{
  "name": "dsh-claude-tui",
  "version": "0.1.1",
  "description": "Unofficial, high-fidelity Claude Code-style TUI for DeepSeek Harness, verified against real PTY captures",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "claude-code",
    "coding-agent",
    "terminal",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogine-ai/dsh-claude-tui.git"
  },
  "homepage": "https://github.com/cogine-ai/dsh-claude-tui#readme",
  "bugs": {
    "url": "https://github.com/cogine-ai/dsh-claude-tui/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-claude-tui": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "docs/**/*",
    "npm-shrinkwrap.json",
    "cordis.patch.yml",
    "README*.md",
    "DISCLAIMER.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "capture:claude-reference": "node scripts/capture-claude-reference.mjs",
    "clean": "node -e \"for (const path of ['lib', 'dist']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "prepack": "tsdown",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run --no-file-parallelism && tsdown"
  },
  "dependencies": {
    "@aws-sdk/credential-provider-node": "3.972.79",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@earendil-works/pi-tui": "0.84.1",
    "commander": "^15.0.0",
    "semver": "7.8.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.1.1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.0-rc.6 <0.1.1",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.6 <0.1.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6 <0.1.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.1.1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.1.1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.1.1",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.6 <0.1.1",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.6 <0.1.1",
    "@deepseek-ai/dsh-user-questions": ">=0.1.0-rc.6 <0.1.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-questions": "0.1.0-rc.6",
    "@types/node": "^24.10.0",
    "@types/semver": "7.8.0",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
