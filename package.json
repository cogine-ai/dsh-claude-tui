{
  "name": "dsh-claude-tui",
  "version": "0.1.6",
  "description": "Unofficial, high-fidelity Claude Code-style TUI for DeepSeek Harness, verified against real PTY captures",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "claude-code",
    "coding-agent",
    "terminal",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogine-ai/dsh-claude-tui.git"
  },
  "homepage": "https://github.com/cogine-ai/dsh-claude-tui#readme",
  "bugs": {
    "url": "https://github.com/cogine-ai/dsh-claude-tui/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-claude-tui": "lib/cli.js",
    "dshtui": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "docs/**/*",
    "!docs/upstream/**",
    "npm-shrinkwrap.json",
    "cordis.patch.yml",
    "README*.md",
    "CONTRIBUTING*.md",
    "DISCLAIMER.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "capture:claude-reference": "node scripts/capture-claude-reference.mjs",
    "clean": "node -e \"for (const path of ['lib', 'dist']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "prepack": "tsdown",
    "test": "tsdown && vitest run --no-file-parallelism",
    "test:bundle:default": "tsdown && DSH_CLAUDE_TUI_INSTALL_MODE=default vitest run tests/bundle.spec.ts --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "docs:dsh:sync": "node scripts/sync-dsh-docs.mjs",
    "docs:dsh:check": "node scripts/sync-dsh-docs.mjs --check",
    "check": "pnpm docs:dsh:check && tsc --noEmit && tsdown && vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/credential-provider-node": "3.972.79",
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "0.1.2-rc.1",
    "@deepseek-ai/dsh-authorization": "0.1.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.1.2-rc.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-rc.1",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.2-rc.1",
    "@deepseek-ai/dsh-hook-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-jobs": "0.1.2-rc.1",
    "@deepseek-ai/dsh-output-retention": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-shell": "0.1.2-rc.1",
    "@deepseek-ai/dsh-spill": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-time": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workflow": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@earendil-works/pi-tui": "0.84.1",
    "commander": "^15.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.8.5",
    "sharp": "0.35.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-agent": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-commands": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-subagent": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-user-approval": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-user-questions": ">=0.1.2-rc.1 <0.1.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/cordis-plugin-loader": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-agent-default-model": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-subagent": { "optional": true },
    "@deepseek-ai/dsh-user-approval": { "optional": true },
    "@deepseek-ai/dsh-user-questions": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.2-rc.1",
    "@deepseek-ai/dsh-user-questions": "0.1.2-rc.1",
    "@types/node": "^24.10.0",
    "@types/semver": "7.8.0",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
