{
  "name": "dsh-claude-tui",
  "version": "0.1.10",
  "description": "Unofficial, high-fidelity Claude Code-style TUI for DeepSeek Harness, verified against real PTY captures",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "claude-code",
    "coding-agent",
    "terminal",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogine-ai/dsh-claude-tui.git"
  },
  "homepage": "https://github.com/cogine-ai/dsh-claude-tui#readme",
  "bugs": {
    "url": "https://github.com/cogine-ai/dsh-claude-tui/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-claude-tui": "lib/cli.js",
    "dshtui": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "docs/**/*",
    "!docs/upstream/**",
    "npm-shrinkwrap.json",
    "cordis.patch.yml",
    "README*.md",
    "CONTRIBUTING*.md",
    "DISCLAIMER.md",
    "LICENSE",
    "vendor/security/README.md",
    "vendor/security/provenance.json"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.2.3"
  },
  "packageManager": "pnpm@11.20.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "capture:claude-reference": "node scripts/capture-claude-reference.mjs",
    "clean": "node -e \"for (const path of ['lib', 'dist']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "prepack": "node -e \"throw new Error('Use corepack pnpm run pack:artifact to pack the verified staged dependency closure')\"",
    "test": "tsdown && vitest run --no-file-parallelism",
    "test:bundle:default": "tsdown && DSH_CLAUDE_TUI_INSTALL_MODE=default vitest run tests/bundle.spec.ts --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "docs:dsh:sync": "node scripts/sync-dsh-docs.mjs",
    "docs:dsh:check": "node scripts/sync-dsh-docs.mjs --check",
    "check": "pnpm docs:dsh:check && tsc --noEmit && tsdown && vitest run --no-file-parallelism",
    "lock:npm": "node scripts/sync-npm-shrinkwrap.mjs",
    "pack:artifact": "tsdown && node scripts/prepare-package.mjs && npm pack --ignore-scripts ./dist"
  },
  "dependencies": {
    "@aws-sdk/credential-provider-node": "3.972.79",
